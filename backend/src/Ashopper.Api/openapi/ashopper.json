  "components": {
    "schemas": {
      "AttributeDefinition": {
        "required": [
          "key",
          "label",
          "type"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/AttributeType"
          },
          "unit": {
            "type": [
              "null",
              "string"
            ]
          },
          "allowedValues": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AttributeType": {
        "enum": [
          "number",
          "enum",
          "bool",
          "text"
        ]
      },
      "BestOffer": {
        "required": [
          "requirementId",
          "offerId",
          "productId",
          "productName",
          "shopId",
          "shopName",
          "url",
          "price",
          "effectivePrice",
          "linePrice"
        ],
        "type": "object",
        "properties": {
          "requirementId": {
            "type": "string",
            "format": "uuid"
          },
          "offerId": {
            "type": "string",
            "format": "uuid"
          },
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "productName": {
            "type": "string"
          },
          "shopId": {
            "type": "string",
            "format": "uuid"
          },
          "shopName": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "effectivePrice": {
            "type": "number",
            "format": "double"
          },
          "linePrice": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "CaptureRequest": {
        "required": [
          "url",
          "html"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "html": {
            "type": "string"
          }
        }
      },
      "CategoryDto": {
        "required": [
          "id",
          "parentId",
          "slug",
          "name",
          "attributes"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "parentId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "attributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttributeDefinition"
            }
          }
        }
      },
      "ConstraintOp": {
        "enum": [
          "eq",
          "neq",
          "gte",
          "lte",
          "between",
          "in",
          "contains"
        ]
      },
      "CreateListRequest": {
        "required": [
          "name",
          "marketCode",
          "allowedShopIds"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "marketCode": {
            "type": "string"
          },
          "allowedShopIds": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "CredentialsRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "CurrentDto": {
        "required": [
          "currency",
          "total",
          "complete",
          "items"
        ],
        "type": "object",
        "properties": {
          "currency": {
            "type": "string"
          },
          "total": {
            "type": "number",
            "format": "double"
          },
          "complete": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurrentItemDto"
            }
          }
        }
      },
      "CurrentItemDto": {
        "required": [
          "requirementId",
          "best"
        ],
        "type": "object",
        "properties": {
          "requirementId": {
            "type": "string",
            "format": "uuid"
          },
          "best": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/BestOffer"
              }
            ]
          }
        }
      },
      "ForgotPasswordRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "HistoryDto": {
        "required": [
          "currency",
          "from",
          "to",
          "points"
        ],
        "type": "object",
        "properties": {
          "currency": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryPointDto"
            }
          }
        }
      },
      "HistoryItemDto": {
        "required": [
          "requirementId",
          "linePrice",
          "shopId"
        ],
        "type": "object",
        "properties": {
          "requirementId": {
            "type": "string",
            "format": "uuid"
          },
          "linePrice": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "shopId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "HistoryPointDto": {
        "required": [
          "day",
          "total",
          "complete",
          "items"
        ],
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "format": "date"
          },
          "total": {
            "type": "number",
            "format": "double"
          },
          "complete": {
            "type": "boolean"
